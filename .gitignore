# Default-deny: publish only explicitly allowed research artifacts.
*
!*/
!.gitignore
!.gitattributes
!/*.py
!/*.md
!/complete_graphs/*.py
!/complete_graphs/*.md
!/vendor/*.py
!/vendor/LICENSE
!/framework/src/**/*.py
!/framework/scripts/*.py
!/framework/README.md
!/framework/requirements-*.txt
!/results/environment.json
!/results/pilot/*summary.csv
!/results/pilot/*trial_means.csv
!/results/pilot/counts.csv
!/results/full/*summary.csv
!/results/full/*trial_means.csv
!/results/full/counts.csv
!/complete_graphs/results/pilot/*summary.csv
!/complete_graphs/results/pilot/*trial_means.csv
!/complete_graphs/results/pilot/counts.csv
!/complete_graphs/results/full/*summary.csv
!/complete_graphs/results/full/*trial_means.csv
!/complete_graphs/results/full/counts.csv
!/complete_graphs/results/fidelity_diagnostic/REPORT.md
!/complete_graphs/results/fidelity_diagnostic/summary.csv
!/complete_graphs/results/fidelity_diagnostic/status.json
!/complete_graphs/results/soft_fidelity_full/REPORT.md
!/complete_graphs/results/soft_fidelity_full/summary.csv
!/complete_graphs/results/soft_fidelity_full/coverage.json
!/complete_graphs/results/soft_fidelity_full/status.json
**/__pycache__/
**/.env*
**/.venv*/
**/data/
**/prepared/
**/cases/
**/.git/
